---
import '../styles/global.css';
import { site, abs } from '../site.config.ts';
import { FORMS } from '../lib/forms.ts';
import baseRate from '../data/base-rate.json';
import { graph, organization, website } from '../lib/ld.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  og?: string;
  ld?: object[];
  pageType: 'home' | 'calc' | 'guide' | 'data' | 'page' | 'notfound';
  ogType?: 'website' | 'article';
  published?: string;
  modified?: string;
}
const { title, description, path, og = '/og/default.png', ld = [], pageType, ogType = 'website', published, modified } = Astro.props;
const canonical = abs(path);
const ogImage = abs(og);
const current = Astro.url.pathname;
const ldJson = JSON.stringify(graph(organization(), website(), ...ld));
const consentRegions = JSON.stringify(site.consentDeniedRegions);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {pageType !== 'notfound' && <link rel="canonical" href={canonical} />}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f4f2ec" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 가이드 RSS`} href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {site.naverVerification && <meta name="naver-site-verification" content={site.naverVerification} />}
    {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}
    <meta name="google-adsense-account" content={site.adsenseClient} />
    <script is:inline define:vars={{ ga4Id: site.ga4Id, consentRegions: JSON.parse(consentRegions) }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      // Consent Mode v2: denied by default in EEA/UK/CH, granted elsewhere.
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', region: consentRegions, wait_for_update: 500 });
      gtag('consent', 'default', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted', wait_for_update: 500 });
      window.__ga4 = ga4Id;
      if (ga4Id) { gtag('js', new Date()); gtag('config', ga4Id); }
      var sent = {};
      window.trackTool = function (name) { if (sent[name]) return; sent[name] = 1; if (window.__ga4) gtag('event', 'tool_used', { tool_name: name }); };
    </script>
    {site.ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>}
    {site.adsEnabled && (<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>)}
    <script type="application/ld+json" set:html={ldJson} />
  </head>
  <body data-page-type={pageType}>
    <a class="skip" href="#main">본문 바로가기</a>
    <header class="mast">
      <div class="mast-in">
        <a class="brand" href="/" aria-label={`${site.name} 처음으로`}>
          <span class="brand-name">{site.name}</span>
          <span class="brand-sub">{site.tagline}</span>
        </a>
        <p class="issue">기준금리 <b class="num">{baseRate.current.rate.toFixed(2)}%</b> · 확인 <span class="num">{baseRate.asOf}</span></p>
        <nav class="toc" aria-label="계산 서식 목록">
          <ol>
            {FORMS.map((f) => (
              <li>
                <a href={f.path} aria-current={current === f.path ? 'page' : undefined}>
                  <small>{f.no}</small>{f.short}
                </a>
              </li>
            ))}
            <li><a href="/guide/" aria-current={current.startsWith('/guide/') ? 'page' : undefined}><small>안내</small>가이드</a></li>
          </ol>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-grid">
        <div>
          <h2>{site.name}</h2>
          <p class="disc">
            {site.name}은 공개된 법령·고시와 한국은행 기준금리로 부동산 거래·보유 비용을 계산하는 참고용 서식입니다.
            세무·법률·대출 상담이 아니며, 실제 세액과 한도는 관할 지자체·금융회사·세무 전문가의 확인이 최종입니다.
          </p>
          <p class="disc">광고 고지: 이 사이트는 Google AdSense 광고를 게재합니다. 현재 제휴(수수료) 링크는 없으며, 생기면 해당 링크 옆과 이 자리에 표시합니다.</p>
        </div>
        <div>
          <h2>안내</h2>
          <ul>
            <li><a href="/about/">소개·편집 기준</a></li>
            <li><a href="/methodology/">계산 방법·자료 출처</a></li>
            <li><a href="/data/conversion-rate-cap/">전환율 상한 변동표</a></li>
            <li><a href="/guide/">가이드 전체</a></li>
          </ul>
        </div>
        <div>
          <h2>정책</h2>
          <ul>
            <li><a href="/contact/">문의</a></li>
            <li><a href="/privacy/">개인정보처리방침</a></li>
            <li><a href="/terms/">이용약관</a></li>
            <li><a href="/disclaimer/">면책 고지</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
