---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Basis from '../../components/Basis.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import MoneyField from '../../components/MoneyField.astro';
import AdSlot from '../../components/AdSlot.astro';
import { calcBrokerage } from '../../lib/calc/brokerage.ts';
import { fmtWon, fmtKorean, fmtPct } from '../../lib/calc/util.ts';
import { basis, BROKER_SALE, BROKER_LEASE } from '../../lib/rules.ts';
import { FORMS } from '../../lib/forms.ts';
import { breadcrumb, faqPage, webApp } from '../../lib/ld.ts';

const form = FORMS[1];
const path = form.path;
const title = '중개보수(복비) 계산기 – 매매·전세·월세 상한요율·한도액과 부가세 2026 기준 | 집계산서';
const description =
  '거래 종류와 금액만 넣으면 공인중개사법 시행규칙 별표1의 상한요율과 한도액으로 매매·전세·월세 중개보수 최대액을 계산하고, 월세 환산 거래금액(×100, ×70)과 부가세 10% 포함 금액까지 보여줍니다. 오피스텔 요율과 협의 기준, 계산 근거 조문도 함께 안내합니다.';
const d = calcBrokerage({ deal: 'sale', kind: 'house', price: 600_000_000, monthly: 0, vat: false });
if (!d.ok) throw new Error();
const ex = calcBrokerage({ deal: 'lease', kind: 'house', price: 300_000_000, monthly: 0, vat: true });
if (!ex.ok) throw new Error();
const mo = calcBrokerage({ deal: 'monthly', kind: 'house', price: 10_000_000, monthly: 500_000, vat: false });
if (!mo.ok) throw new Error();
const man = (n: number) => (n >= 1e8 ? `${n / 1e8}억원` : `${n / 1e4}만원`);
const rangeLabel = (table: typeof BROKER_SALE, i: number) => {
  const lo = i === 0 ? 0 : table[i - 1][0];
  const hi = table[i][0];
  if (i === 0) return `${man(hi)} 미만`;
  if (hi === Infinity) return `${man(lo)} 이상`;
  return `${man(lo)} 이상 ~ ${man(hi)} 미만`;
};
const faq = [
  {
    q: '전세 3억원 중개보수는 얼마인가요?',
    a: `주택 임대차 1억원 이상 6억원 미만 구간의 상한요율은 0.3%이므로 최대 ${fmtWon(ex.fee)}입니다. 중개사무소가 일반과세자라면 부가세 10%를 더해 ${fmtWon(ex.total)}까지 받을 수 있습니다.`,
  },
  {
    q: '월세 중개보수는 어떻게 계산하나요?',
    a: `거래금액을 보증금 + 월세×100으로 환산하고, 그 값이 5천만원 미만이면 보증금 + 월세×70을 씁니다. 보증금 1천만원·월세 50만원이면 6천만원이 거래금액이 되어 0.4%인 ${fmtWon(mo.fee)}이 상한입니다.`,
  },
  {
    q: '상한요율만큼 꼭 내야 하나요?',
    a: '아닙니다. 별표1의 요율은 받을 수 있는 최대치이고, 실제 보수는 그 범위 안에서 중개의뢰인과 개업공인중개사가 협의해 정합니다. 계약 전에 금액을 정해 두는 것이 분쟁을 줄입니다.',
  },
  {
    q: '중개보수에 부가세가 붙나요?',
    a: '중개사무소가 부가가치세 일반과세자면 중개보수의 10%가 별도로 붙을 수 있고, 간이과세자는 다른 기준이 적용됩니다. 사업자등록증의 과세 유형을 확인하고 현금영수증이나 세금계산서를 받으세요.',
  },
];
const ld = [
  webApp({ name: form.title, path, description, dateModified: form.updated }),
  breadcrumb([{ name: '홈', path: '/' }, { name: form.title, path }]),
  faqPage(faq),
];
---
<Base title={title} description={description} path={path} og={form.og} ld={ld} pageType="calc" modified={form.updated}>
  <article class="sheet">
    <Crumbs items={[{ name: '홈', path: '/' }, { name: form.title, path }]} />
    <p class="form-no">[서식 {form.no}] {form.title}</p>
    <h1>복비(중개보수)는 최대 얼마까지 낼까요?</h1>
    <p class="lead" data-answer>
      <strong>주택 중개보수 상한은 매매 0.4~0.7%, 임대차 0.3~0.6%</strong>로 금액 구간별로 정해져 있고, 5천만원·1억원·2억원 미만 구간에는 한도액이 있습니다.
      실제 보수는 이 상한 안에서 협의하며, 일반과세자 중개사무소는 부가세 10%를 별도로 받을 수 있습니다(시행규칙 별표1, {form.updated} 대조).
    </p>

    <div class="desk" data-calc="brokerage">
      <form id="br-form" novalidate>
        <p class="part">입 력 란</p>
        <fieldset class="fields">
          <legend class="vh">거래 조건</legend>
          <div class="row">
            <span class="lab" id="deal-l">거래 종류</span>
            <div class="val choices" role="radiogroup" aria-labelledby="deal-l">
              <label><input type="radio" name="deal" value="sale" checked /> 매매·교환</label>
              <label><input type="radio" name="deal" value="lease" /> 전세</label>
              <label><input type="radio" name="deal" value="monthly" /> 월세</label>
            </div>
          </div>
          <div class="row">
            <label class="lab" for="kind">대상</label>
            <div class="val">
              <select id="kind" name="kind">
                <option value="house" selected>주택 (아파트·빌라·단독 등)</option>
                <option value="officetel">오피스텔 (전용 85㎡ 이하, 부엌·화장실 등 갖춤)</option>
                <option value="other">그 밖의 부동산 (상가·토지·요건 밖 오피스텔)</option>
              </select>
            </div>
          </div>
          <MoneyField id="price" label="거래금액" sub="매매가 또는 보증금" value={600_000_000} />
          <div data-show="monthly-row" hidden>
            <MoneyField id="monthly" label="월세" sub="월 차임" value={500_000} required={false} />
          </div>
          <div class="row">
            <span class="lab">부가세</span>
            <div class="val"><label class="check"><input type="checkbox" name="vat" /> 일반과세자 사무소 (10% 별도)</label></div>
          </div>
        </fieldset>
      </form>

      <div class="ledger-wrap">
        <table class="ledger">
          <caption>산 출 내 역</caption>
          <tbody>
            <tr><th scope="row"><span class="no">①</span>거래금액 <span class="rate" data-out="baseNote">({d.baseNote})</span></th><td data-out="base">{fmtWon(d.base)}</td></tr>
            <tr><th scope="row"><span class="no">②</span>상한요율</th><td data-out="rate">{fmtPct(d.rate)}</td></tr>
            <tr><th scope="row"><span class="no">③</span>한도액</th><td data-out="cap">{d.cap ? fmtWon(d.cap) : '없음'}</td></tr>
            <tr><th scope="row"><span class="no">④</span>중개보수 상한</th><td data-out="fee">{fmtWon(d.fee)}</td></tr>
            <tr><th scope="row"><span class="no">⑤</span>부가세</th><td data-out="vat">{fmtWon(d.vatAmount)}</td></tr>
          </tbody>
          <tfoot>
            <tr><th scope="row">최대 지급액</th><td><span data-out="total">{fmtWon(d.total)}</span><span class="words" data-out="totalWords">{fmtKorean(d.total)}</span></td></tr>
          </tfoot>
        </table>
        <p class="notice" data-out="note"></p>
        <Basis items={[basis.brokerage]} extra="오피스텔 외 주택 이외 중개대상물은 0.9% 이내에서 협의합니다." />
      </div>
    </div>
  </article>

  <AdSlot id="calc-below" />

  <section class="sheet prose">
    <h2>주택 매매 중개보수 요율표는?</h2>
    <div class="tbl-wrap">
      <table class="tbl">
        <caption>공인중개사법 시행규칙 [별표 1] 주택 매매·교환 — {form.updated} 대조</caption>
        <thead><tr><th scope="col">거래금액</th><th scope="col">상한요율</th><th scope="col">한도액</th></tr></thead>
        <tbody>
          {BROKER_SALE.map((b, i) => (<tr><td>{rangeLabel(BROKER_SALE, i)}</td><td class="num">{fmtPct(b[1])}</td><td class="num">{b[2] ? fmtWon(b[2]) : '없음'}</td></tr>))}
        </tbody>
      </table>
    </div>
    <h2>전세·월세 중개보수 요율표는?</h2>
    <div class="tbl-wrap">
      <table class="tbl">
        <caption>공인중개사법 시행규칙 [별표 1] 주택 임대차 등 — {form.updated} 대조</caption>
        <thead><tr><th scope="col">거래금액</th><th scope="col">상한요율</th><th scope="col">한도액</th></tr></thead>
        <tbody>
          {BROKER_LEASE.map((b, i) => (<tr><td>{rangeLabel(BROKER_LEASE, i)}</td><td class="num">{fmtPct(b[1])}</td><td class="num">{b[2] ? fmtWon(b[2]) : '없음'}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p>구간 경계는 "미만"입니다. 매매 9억원은 9억원 이상 12억원 미만 구간이라 0.5%(450만원)가 상한이고, 8억 9,999만원이면 0.4%가 적용됩니다. 한도액이 있는 구간에서는 요율로 계산한 금액과 한도액 중 적은 쪽이 상한입니다.</p>
    <h2>월세는 거래금액을 어떻게 환산하나요?</h2>
    <p>월세 계약은 보증금에 월세의 100배를 더한 금액을 거래금액으로 봅니다. 이 금액이 5천만원 미만이면 월세의 70배를 더한 금액으로 다시 계산합니다. 보증금 500만원·월세 30만원이면 3,500만원이 5천만원 미만이므로 500만 + 2,100만 = 2,600만원에 0.5%를 곱한 13만원이 상한입니다.</p>
    <h2>이 계산서가 하지 않는 것</h2>
    <ul>
      <li>분양권 거래금액(납입액 + 프리미엄), 교환(큰 쪽 가액), 동일 기회 매매·임대 동시 거래 같은 특수 산정은 직접 금액을 넣어야 합니다.</li>
      <li>시·도 조례는 별표1 범위 안에서 정하므로 여기서는 별표1 상한만 계산합니다.</li>
    </ul>
    <p class="changelog">변경 이력: {form.updated} — 별표1 원문 대조(2021-10-19 개정 요율 유지 확인).</p>
  </section>

  <section class="sheet prose">
    <Faq faq={faq} />
    <Related
      links={[
        { href: '/guide/negotiating-brokerage-fee/', title: '중개보수 협의는 언제, 어떻게 하나요', note: '가이드' },
        { href: '/guide/jeonse-contract-documents/', title: '전세 계약 전 확인할 서류 7가지', note: '가이드' },
        { href: '/calc/acquisition-tax/', title: '주택 취득세 계산서', note: '서식 제1호' },
        { href: '/calc/jeonse-conversion/', title: '전월세 전환 계산서', note: '서식 제3호' },
      ]}
    />
  </section>
</Base>

<script>
  import { calcBrokerage, type Deal, type Kind } from '../../lib/calc/brokerage.ts';
  import { fmtWon, fmtKorean, fmtPct } from '../../lib/calc/util.ts';
  import { wire, money, checked, radio, out, show, clearErrors, fieldError } from '../../lib/client.ts';
  const form = document.getElementById('br-form') as HTMLFormElement;
  const desk = form.closest('[data-calc]') as HTMLElement;
  wire(form, 'brokerage_fee', () => {
    clearErrors(form);
    const deal = radio(form, 'deal') as Deal;
    show(desk, 'monthly-row', deal === 'monthly');
    const r = calcBrokerage({
      deal,
      kind: (form.elements.namedItem('kind') as HTMLSelectElement).value as Kind,
      price: money(form, 'price'),
      monthly: deal === 'monthly' ? money(form, 'monthly') : 0,
      vat: checked(form, 'vat'),
    });
    if (!r.ok) {
      fieldError(form, r.field, r.message);
      desk.dataset.state = 'invalid';
      out(desk, 'note', '입력값을 고치면 다시 계산합니다.');
      return;
    }
    desk.dataset.state = 'ok';
    out(desk, 'baseNote', `(${r.baseNote})`);
    out(desk, 'base', fmtWon(r.base));
    out(desk, 'rate', r.negotiable ? `${fmtPct(r.rate)} 이내 협의` : fmtPct(r.rate));
    out(desk, 'cap', r.cap ? fmtWon(r.cap) : '없음');
    out(desk, 'fee', fmtWon(r.fee));
    out(desk, 'vat', fmtWon(r.vatAmount));
    out(desk, 'total', fmtWon(r.total));
    out(desk, 'totalWords', fmtKorean(r.total));
    out(desk, 'note', r.capped ? '요율로 계산한 금액이 한도액을 넘어 한도액이 상한입니다.' : r.negotiable ? '주택 외 중개대상물은 0.9% 이내에서 협의로 정합니다.' : '');
  });
</script>
