---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Basis from '../../components/Basis.astro';
import Faq from '../../components/Faq.astro';
import Related from '../../components/Related.astro';
import MoneyField from '../../components/MoneyField.astro';
import NumField from '../../components/NumField.astro';
import AdSlot from '../../components/AdSlot.astro';
import { calcConversion, conversionCap } from '../../lib/calc/conversion.ts';
import { fmtWon, fmtKorean } from '../../lib/calc/util.ts';
import { basis } from '../../lib/rules.ts';
import { FORMS } from '../../lib/forms.ts';
import baseRate from '../../data/base-rate.json';
import { breadcrumb, faqPage, webApp } from '../../lib/ld.ts';

const form = FORMS[2];
const path = form.path;
const br = baseRate.current.rate;
const cap = conversionCap(br);
const capStr = cap.toFixed(2);
const title = `전월세 전환율 계산기 – 법정 상한 ${capStr}% 기준 보증금 감액 시 월세 최대 인상액 | 집계산서`;
const description = `보증금을 낮추고 월세로 바꿀 때 받을 수 있는 최대 월세를 주택임대차보호법 시행령 제9조 상한(기준금리 ${br.toFixed(2)}% + 2%p = ${capStr}%)으로 계산하고, 집주인이 제시한 월세의 실제 전환율이 상한을 넘는지도 바로 확인합니다. 계약 갱신 때도 그대로 쓸 수 있습니다(무료).`;
const d = calcConversion({ oldDeposit: 300_000_000, newDeposit: 200_000_000, currentMonthly: 0, ratePct: cap, proposedMonthly: 500_000 });
if (!d.ok) throw new Error();
const prev = baseRate.history[1];
const faq = [
  {
    q: `지금 전월세 전환율 상한은 몇 %인가요?`,
    a: `${baseRate.asOf} 확인 기준 한국은행 기준금리는 ${br.toFixed(2)}%(${baseRate.current.date} 결정)이므로 전환율 상한은 ${br.toFixed(2)}% + 2%p = ${capStr}%입니다. 연 10%와 비교해 낮은 쪽이 상한입니다.`,
  },
  {
    q: '보증금 1억원을 월세로 바꾸면 월세는 최대 얼마인가요?',
    a: `상한 ${capStr}%를 적용하면 연 ${fmtWon(Math.floor(1e8 * cap / 100))}, 월 ${fmtWon(Math.floor(1e8 * cap / 100 / 12))}이 최대입니다. 이보다 높게 받기로 했다면 초과분은 효력이 없습니다.`,
  },
  {
    q: '전환율 상한은 신규 계약에도 적용되나요?',
    a: '주택임대차보호법 제7조의2는 계약 기간 중이나 갱신 시 보증금 전부 또는 일부를 월세로 전환하는 경우에 적용됩니다. 새 임차인과 처음 맺는 계약의 보증금·월세 조합은 원칙적으로 당사자가 정합니다.',
  },
  {
    q: '한국부동산원이 발표하는 전월세전환율과 무엇이 다른가요?',
    a: '한국부동산원 전월세전환율은 실제 계약에서 관찰된 시장 통계이고, 이 계산서의 상한은 법이 정한 최고 한도입니다. 시장 통계가 상한보다 높게 나와도 기존 계약의 전환에는 법정 상한이 적용됩니다.',
  },
];
const ld = [
  webApp({ name: form.title, path, description, dateModified: form.updated }),
  breadcrumb([{ name: '홈', path: '/' }, { name: form.title, path }]),
  faqPage(faq),
];
---
<Base title={title} description={description} path={path} og={form.og} ld={ld} pageType="calc" modified={form.updated}>
  <article class="sheet">
    <Crumbs items={[{ name: '홈', path: '/' }, { name: form.title, path }]} />
    <div class="form-no">[서식 {form.no}] {form.title}</div>
    <h1>보증금을 월세로 바꾸면 월세는 최대 얼마인가요?</h1>
    <p class="lead" data-answer>
      <strong>전월세 전환율 상한은 연 {capStr}%</strong>입니다. 한국은행 기준금리 {br.toFixed(2)}%({baseRate.current.date} 결정)에 2%p를 더한 값으로, 보증금 1억원을 월세로 바꾸면 월 {fmtWon(Math.floor(1e8 * cap / 100 / 12))}까지만 받을 수 있습니다({baseRate.asOf} 한국은행 공시 확인).
    </p>

    <dl class="kv" aria-label="오늘 적용 기준값">
      <div><dt>한국은행 기준금리</dt><dd>{br.toFixed(2)}%</dd><dd class="meta">{baseRate.current.date} 결정 · 직전 {prev.rate.toFixed(2)}% ({prev.date})</dd></div>
      <div><dt>법정 전환율 상한</dt><dd>{capStr}%</dd><dd class="meta">min(연 10%, 기준금리 + 2%p)</dd></div>
      <div><dt>자료 확인일</dt><dd class="num">{baseRate.asOf}</dd><dd class="meta"><a href={baseRate.sourceUrl} rel="noopener" target="_blank">{baseRate.source}</a></dd></div>
    </dl>

    <div class="desk" data-calc="conversion">
      <form id="cv-form" novalidate>
        <p class="part">입 력 란</p>
        <fieldset class="fields">
          <legend class="vh">전환 조건</legend>
          <MoneyField id="oldDeposit" label="현재 보증금" value={300_000_000} />
          <MoneyField id="newDeposit" label="바꿀 보증금" sub="낮아진 보증금" value={200_000_000} />
          <MoneyField id="currentMonthly" label="현재 월세" sub="전세면 0" value={0} required={false} />
          <NumField id="ratePct" label="적용 전환율" sub="기본값 = 법정 상한" value={cap} unit="%" step="0.01" min="0" max="20" hint={`법정 상한 ${capStr}%. 더 낮게 합의했다면 그 값을 넣으세요.`} />
          <MoneyField id="proposedMonthly" label="제시받은 새 월세" sub="선택 · 상한 초과 확인" value={500_000} required={false} />
        </fieldset>
      </form>

      <div class="ledger-wrap">
        <table class="ledger">
          <caption>산 출 내 역</caption>
          <tbody>
            <tr><th scope="row"><span class="no">①</span>월세로 바뀌는 보증금</th><td data-out="converted">{fmtWon(d.converted)}</td></tr>
            <tr><th scope="row"><span class="no">②</span>연간 월세 상당액</th><td data-out="annual">{fmtWon(d.annual)}</td></tr>
            <tr><th scope="row"><span class="no">③</span>추가 월세 상한</th><td data-out="add">{fmtWon(d.addMonthly)}</td></tr>
            <tr><th scope="row"><span class="no">④</span>제시 월세의 실제 전환율</th><td data-out="implied">{d.implied !== null ? `${d.implied}%` : '—'}</td></tr>
          </tbody>
          <tfoot>
            <tr><th scope="row">새 월세 상한</th><td><span data-out="max">{fmtWon(d.maxMonthly)}</span><span class="words" data-out="maxWords">{fmtKorean(d.maxMonthly)}</span></td></tr>
          </tfoot>
        </table>
        <p class={`notice ${d.exceeds ? 'bad' : ''}`} data-out="note" data-note>{d.exceeds ? `제시 월세의 전환율 ${d.implied}%가 적용 전환율 ${capStr}%를 넘습니다. 초과분은 주택임대차보호법상 효력이 없습니다.` : ''}</p>
        <Basis items={[basis.conversion]} extra={`기준금리는 ${baseRate.asOf}에 한국은행 공시표에서 자동으로 확인한 값입니다.`} />
      </div>
    </div>
  </article>

  <AdSlot id="calc-below" />

  <section class="sheet prose">
    <h2>전환율 상한은 어떻게 계산하나요?</h2>
    <p>주택임대차보호법 시행령 제9조는 보증금을 월차임으로 전환할 때의 산정률을 "연 1할(10%)"과 "한국은행 기준금리에 연 2%를 더한 비율" 중 낮은 비율로 정합니다. {baseRate.asOf} 기준 기준금리 {br.toFixed(2)}%에 2%p를 더한 {capStr}%가 10%보다 낮으므로 {capStr}%가 상한입니다.</p>
    <p>계산식은 간단합니다. 월세 = (낮아지는 보증금) × 전환율 ÷ 12. 보증금을 3억원에서 2억원으로 1억원 낮추면 1억원 × {capStr}% ÷ 12 = {fmtWon(Math.floor(1e8 * cap / 100 / 12))}이 추가 월세의 최대치입니다.</p>
    <h2>최근 기준금리 변화에 따라 상한은 어떻게 바뀌었나요?</h2>
    <div class="tbl-wrap">
      <table class="tbl">
        <caption>최근 결정 5회 — {baseRate.source}, {baseRate.asOf} 확인</caption>
        <thead><tr><th scope="col">결정일</th><th scope="col">기준금리</th><th scope="col">전환율 상한</th></tr></thead>
        <tbody>
          {baseRate.history.slice(0, 5).map((h) => (<tr><td class="num">{h.date}</td><td class="num">{h.rate.toFixed(2)}%</td><td class="num">{conversionCap(h.rate).toFixed(2)}%</td></tr>))}
        </tbody>
      </table>
    </div>
    <p>전체 변동 이력은 <a href="/data/conversion-rate-cap/">전월세 전환율 상한 변동표</a>에서 볼 수 있습니다.</p>
    <h2>이 계산서가 하지 않는 것</h2>
    <ul>
      <li>월세를 보증금으로 되돌리는 역전환(월세 → 보증금)에는 법정 상한이 없으므로 계산하지 않습니다.</li>
      <li>상가건물 임대차는 상가건물 임대차보호법 시행령의 별도 기준(연 12% 또는 기준금리×4.5배 중 낮은 비율)을 따릅니다.</li>
    </ul>
    <p class="changelog">변경 이력: {baseRate.asOf} — 한국은행 기준금리 공시표 자동 확인 ({baseRate.current.date} 결정 {br.toFixed(2)}%).</p>
  </section>

  <section class="sheet prose">
    <Faq faq={faq} />
    <Related
      links={[
        { href: '/guide/jeonse-to-monthly-conversion-cap/', title: '전월세 전환율 상한 5% 계산법과 예외', note: '가이드' },
        { href: '/data/conversion-rate-cap/', title: '전월세 전환율 상한 변동표 (1999년~)', note: '데이터' },
        { href: '/calc/brokerage-fee/', title: '중개보수 상한 계산서', note: '서식 제2호' },
        { href: '/guide/fixed-date-and-move-in-report/', title: '확정일자·전입신고와 대항력', note: '가이드' },
      ]}
    />
  </section>
</Base>

<script>
  import { calcConversion } from '../../lib/calc/conversion.ts';
  import { fmtWon, fmtKorean } from '../../lib/calc/util.ts';
  import { wire, money, num, out, clearErrors, fieldError } from '../../lib/client.ts';
  const form = document.getElementById('cv-form') as HTMLFormElement;
  const desk = form.closest('[data-calc]') as HTMLElement;
  const note = desk.querySelector('[data-note]') as HTMLElement;
  wire(form, 'jeonse_conversion', () => {
    clearErrors(form);
    const proposed = money(form, 'proposedMonthly');
    const rate = num(form, 'ratePct');
    const r = calcConversion({
      oldDeposit: money(form, 'oldDeposit'),
      newDeposit: money(form, 'newDeposit'),
      currentMonthly: money(form, 'currentMonthly'),
      ratePct: rate,
      proposedMonthly: Number.isFinite(proposed) ? proposed : undefined,
    });
    if (!r.ok) {
      fieldError(form, r.field, r.message);
      desk.dataset.state = 'invalid';
      note.className = 'notice';
      out(desk, 'note', '입력값을 고치면 다시 계산합니다.');
      return;
    }
    desk.dataset.state = 'ok';
    out(desk, 'converted', fmtWon(r.converted));
    out(desk, 'annual', fmtWon(r.annual));
    out(desk, 'add', fmtWon(r.addMonthly));
    out(desk, 'implied', r.implied !== null ? `${r.implied}%` : '—');
    out(desk, 'max', fmtWon(r.maxMonthly));
    out(desk, 'maxWords', fmtKorean(r.maxMonthly));
    note.className = 'notice' + (r.exceeds ? ' bad' : '');
    out(desk, 'note', r.exceeds ? `제시 월세의 전환율 ${r.implied}%가 적용 전환율 ${rate}%를 넘습니다. 초과분은 주택임대차보호법상 효력이 없습니다.` : r.implied !== null ? `제시 월세의 전환율 ${r.implied}%는 적용 전환율 이내입니다.` : '');
  });
</script>
